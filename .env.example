# Mail Simply configuration. Every variable is optional; the defaults are shown.
# Variables set in the real environment (e.g. PHP-FPM env[...]) take precedence
# over this file, and config.php, when present, takes precedence over both.

MAIL_SIMPLY_TITLE="Mail Simply"
# Linked from the sign-in page and the account menu.
MAIL_SIMPLY_PANEL_URL=
MAIL_SIMPLY_SUPPORT_URL=
# The interface language when neither the user nor the browser asks for one
# it has: en or hu.
MAIL_SIMPLY_LANGUAGE=en

# The IMAP server every session reads mail from. ENCRYPTION is ssl (implicit
# TLS, usually port 993), starttls (usually 143) or none (loopback only).
# Roundcube's "ssl://host:993" and "tls://host" spellings are understood too.
MAIL_SIMPLY_IMAP_HOST=127.0.0.1
MAIL_SIMPLY_IMAP_PORT=143
MAIL_SIMPLY_IMAP_ENCRYPTION=starttls
# Leave VERIFY on. Point CA at a file when the server's certificate is not
# signed by a public authority, rather than turning verification off.
MAIL_SIMPLY_IMAP_VERIFY=true
MAIL_SIMPLY_IMAP_CA=
MAIL_SIMPLY_IMAP_TIMEOUT=30

# The submission server mail is sent through, as the signed-in mailbox.
MAIL_SIMPLY_SMTP_HOST=127.0.0.1
MAIL_SIMPLY_SMTP_PORT=587
MAIL_SIMPLY_SMTP_ENCRYPTION=starttls
MAIL_SIMPLY_SMTP_VERIFY=true
MAIL_SIMPLY_SMTP_CA=
MAIL_SIMPLY_SMTP_TIMEOUT=30
MAIL_SIMPLY_SMTP_AUTH=true

# One-click sign-in from a control panel. The panel mints a token and sends
# the browser to sso.php?token=...; Mail Simply redeems it with
# POST {SSO_URL}/{token} and "Authorization: Bearer {SSO_SECRET}", and opens
# the mailbox it names as the Dovecot master user below. Leave any of the four
# empty and sign-on is off.
MAIL_SIMPLY_SSO_URL=
MAIL_SIMPLY_SSO_SECRET=
MAIL_SIMPLY_SSO_TIMEOUT=5
# The panel page that mints a token bound to the browser: sso.php?start sends
# the browser there with ?binding=<hash>. See "Signing users in" in README.md.
MAIL_SIMPLY_SSO_ISSUE_URL=
# Once the panel binds every token, refuse any token that is not bound.
MAIL_SIMPLY_SSO_REQUIRE_BINDING=false
MAIL_SIMPLY_MASTER_USER=
MAIL_SIMPLY_MASTER_PASSWORD=

# The password form. Turn it off where the panel is the only way in.
MAIL_SIMPLY_LOGIN_FORM=true
# Appended to a bare user name typed into the form ("info" -> "info@<domain>").
MAIL_SIMPLY_LOGIN_DOMAIN=
# Failed sign-ins allowed in 15 minutes before the form refuses, per address
# and per client address (REMOTE_ADDR: behind a proxy, set the real address in
# the web server, or use 0 to turn the per-client limit off).
MAIL_SIMPLY_LOGIN_MAX_ATTEMPTS=5
MAIL_SIMPLY_LOGIN_MAX_ATTEMPTS_PER_CLIENT=30

# Sessions. Leave SESSION_PATH empty to use storage/sessions.
MAIL_SIMPLY_SESSION_PATH=
MAIL_SIMPLY_SESSION_NAME=MailSimplySession
# Set to false only for local development over plain HTTP.
MAIL_SIMPLY_SESSION_SECURE=true
MAIL_SIMPLY_SESSION_IDLE_TIMEOUT=3600
MAIL_SIMPLY_SESSION_LIFETIME=43200

# Where each mailbox's settings and uploads not yet sent are kept. Empty means
# storage/users and storage/uploads.
MAIL_SIMPLY_USERS_DIR=
MAIL_SIMPLY_UPLOADS_DIR=

# Limits: messages per page, bytes of attachments per message, recipients per
# message.
MAIL_SIMPLY_PAGE_SIZE=50
MAIL_SIMPLY_MAX_ATTACHMENTS=26214400
MAIL_SIMPLY_MAX_RECIPIENTS=100
